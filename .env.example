# CTFd
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=

# Provider credentials are optional when Claude Code/Codex already has a login.
# Uncomment only the providers you actually use, and keep values in local .env.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional: override the inherited Claude Code gateway for Claude SDK solvers only.
# Leave these unset to use the current Claude Code gateway for both coordinator and solvers.
# SOLVER_ROUTER_URL=http://127.0.0.1:20128/v1
# SOLVER_ROUTER_KEY=<newly-issued-local-router-key>
# SOLVER_ROUTER_AUTH=bearer  # or x-api-key, depending on the router
# SOLVER_MODEL=claude-sdk/<router-model-id>
